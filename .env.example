QWEN_MODEL=qwen2.5-coder:7b-instruct-q4_K_M
QWEN_CONTEXT=8192
QWEN_TEMPERATURE=0.25

OLLAMA_BASE_URL=http://127.0.0.1:11434

# Durée maximale d'une génération Ollama, en secondes.
OLLAMA_TIMEOUT_SECONDS=300

# Durée pendant laquelle Ollama garde le modèle chargé en mémoire.
OLLAMA_KEEP_ALIVE=10m

DJANGO_DEBUG=1
DJANGO_SECRET_KEY=local-development-secret-key

# Hôtes autorisés à accéder au front Django.
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

FRONT_HOST=127.0.0.1
FRONT_PORT=5635

API_HOST=127.0.0.1
API_PORT=8000

WORKSPACE_ROOT=workspace/projects

# Adresse utilisée par Django pour contacter FastAPI.
MYCODER_API_BASE_URL=http://127.0.0.1:8000

# Les appels Django vers FastAPI sont désormais courts :
# création du job ou lecture de son statut.
MYCODER_API_TIMEOUT_SECONDS=15

# Connexion au broker RabbitMQ local.
RABBITMQ_URL=amqp://guest:guest@127.0.0.1:5672/

# File contenant les demandes envoyées au worker.
RABBITMQ_JOB_QUEUE=mycoder.jobs

# File contenant les changements d'état et les résultats.
RABBITMQ_EVENT_QUEUE=mycoder.events